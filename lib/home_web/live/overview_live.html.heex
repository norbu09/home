<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  active_nav={:overview}
  secret_count={@secret_count}
>
  <.page_header
    id="overview-header"
    title="Tactical Overview"
    subtitle={"#{Calendar.strftime(@today, "%A · %d %B %Y")} // local command state"}
  >
    <:actions>
      <.local_clock id="overview-local-clock" />
    </:actions>
  </.page_header>

  <section id="overview-vitals" class="router-metrics overview-vitals" aria-label="Current status">
    <.metric
      id="overview-projects"
      label="Active workstreams"
      value={@active_projects}
      detail="LLM activity this month"
      icon="hero-squares-2x2"
      tone="cyan"
    />
    <.metric
      id="overview-calls"
      label="Calls today"
      value={@today_calls}
      detail="through local router"
      icon="hero-bolt"
      tone="green"
    />
    <.metric
      id="overview-tokens"
      label="Tokens today"
      value={@today_tokens}
      detail="input + output"
      icon="hero-code-bracket"
      tone="magenta"
    />
    <.metric
      id="overview-cost"
      label="Month cost"
      value={@month_cost}
      detail="persisted + live"
      icon="hero-banknotes"
      tone="green"
    />
  </section>

  <div class="tactical-grid">
    <section id="current-focus" class="cyber-panel tactical-panel tactical-focus">
      <header class="cyber-panel-header">
        <div>
          <h2>// Current focus</h2><p>Combined model, commit, and memory activity</p>
        </div>
        <span class="cyber-tag">LIVE SIGNAL</span>
      </header>
      <div id="focus-stream" phx-update="stream" class="focus-list">
        <div :if={@focuses_empty?} id="focus-empty" class="tactical-empty">
          <.icon name="hero-signal-slash" class="size-5" /><span>No recent project signals</span>
        </div>
        <.link
          :for={{id, focus} <- @streams.focuses}
          id={id}
          navigate={~p"/router/projects/#{focus.id}"}
          class="focus-row focus-project-link"
        >
          <div class="focus-rank"></div>
          <div>
            <strong>{String.upcase(focus.name)}</strong><span>{focus_summary(focus)}</span>
          </div>
          <div>
            <strong>{signal_label(focus.signal_count)}</strong><span>{relative_timestamp(
              focus.last_seen_at
            )}</span>
          </div>
        </.link>
      </div>
    </section>

    <section id="commit-history" class="cyber-panel tactical-panel commit-history-panel">
      <header class="cyber-panel-header">
        <div>
          <h2>// Commit history</h2><p>{@git_commit_count} recent changes grouped by project</p>
        </div>
        <button
          id="refresh-git-activity"
          class="cyber-icon-button"
          phx-click="refresh_git_activity"
          title="Refresh commit history"
          aria-label="Refresh commit history"
        ><.icon name="hero-arrow-path" class="size-3" /></button>
      </header>
      <div id="git-project-stream" phx-update="stream" class="git-project-list">
        <div :if={@git_projects_empty?} id="git-projects-empty" class="tactical-empty">
          <.icon name="hero-code-bracket-square" class="size-5" /><span>No commits in the current window</span>
        </div>
        <article
          :for={{id, project} <- @streams.git_projects_stream}
          id={id}
          class="git-project-group"
        >
          <header>
            <.link navigate={~p"/router/projects/#{project.id}"} class="git-project-link">{String.upcase(
              project.name
            )}</.link><span>{project.commit_count} COMMITS</span>
          </header>
          <div class="git-commit-list">
            <a
              :for={commit <- project.commits}
              id={commit.id}
              href={commit.url}
              target="_blank"
              rel="noopener noreferrer"
              class="git-commit-row"
            >
              <code>{commit.short_sha}</code><span>{commit.subject}</span><time>{relative_timestamp(
                commit.committed_at
              )}</time>
            </a>
          </div>
        </article>
      </div>
    </section>

    <section id="personal-goals" class="cyber-panel tactical-panel tactical-goals">
      <header class="cyber-panel-header">
        <div>
          <h2>// Personal goals</h2><p>{@goal_progress}% complete in current stack</p>
        </div>
        <button
          id="add-goal"
          class="cyber-icon-button"
          phx-click="toggle_form"
          phx-value-kind="goal"
          title="Add goal"
          aria-label="Add goal"
        ><.icon name="hero-plus" class="size-4" /></button>
      </header>
      <.form
        :if={@show_goal_form}
        for={@goal_form}
        id="goal-form"
        phx-submit="save_goal"
        class="tactical-inline-form goal-form"
      >
        <.input
          field={@goal_form[:title]}
          type="text"
          placeholder="Objective"
          class="cyber-text-input"
        />
        <.input field={@goal_form[:due_on]} type="date" class="cyber-text-input" />
        <.input
          field={@goal_form[:priority]}
          type="select"
          options={[{"Priority 1", 1}, {"Priority 2", 2}, {"Priority 3", 3}]}
          class="cyber-text-input"
        />
        <button type="submit" class="cyber-primary-button">Commit</button>
      </.form>
      <div id="goal-stream" phx-update="stream" class="goal-list">
        <div :if={@goals_empty?} id="goals-empty" class="tactical-empty">
          <.icon name="hero-flag" class="size-5" /><span>No personal goals defined</span>
        </div>
        <article
          :for={{id, goal} <- @streams.goals}
          id={id}
          class={["goal-row", goal.status == "completed" && "is-complete"]}
        >
          <button
            id={"toggle-goal-#{goal.id}"}
            phx-click="toggle_goal"
            phx-value-id={goal.id}
            class="goal-check"
            aria-label={"Toggle #{goal.title}"}
          ><.icon
            name={if goal.status == "completed", do: "hero-check", else: "hero-minus"}
            class="size-3"
          /></button>
          <div>
            <strong>{goal.title}</strong><span>P{goal.priority} · {due_date(goal.due_on)}</span>
          </div>
          <button
            id={"dismiss-goal-#{goal.id}"}
            phx-click="dismiss_item"
            phx-value-id={goal.id}
            class="cyber-icon-button"
            title="Dismiss goal"
            aria-label={"Dismiss #{goal.title}"}
          ><.icon name="hero-x-mark" class="size-3" /></button>
        </article>
      </div>
    </section>

    <section id="cognee-insights" class="cyber-panel tactical-panel tactical-insights">
      <header class="cyber-panel-header">
        <div>
          <h2>// Cognee insights</h2><p>Memory signals promoted into tactical context</p>
        </div>
        <div class="insight-header-actions">
          <span class={["cyber-status-label", @cognee_status != :ready && "is-idle"]}>{cognee_status(
            @cognee_status,
            @cognee_dataset_count
          )}</span>
          <button
            id="refresh-cognee-insights"
            class="cyber-icon-button"
            phx-click="refresh_cognee_insights"
            title="Refresh Cognee insights"
            aria-label="Refresh Cognee insights"
          ><.icon name="hero-arrow-path" class="size-3" /></button>
        </div>
      </header>
      <div id="insight-stream" phx-update="stream" class="insight-list">
        <div :if={@insights_empty?} id="insights-empty" class="tactical-empty insight-empty">
          <.icon name="hero-circle-stack" class="size-5" /><strong>Insight channel ready</strong><span>Cognee dataset activity will be summarized after the next scan.</span>
        </div>
        <article :for={{id, insight} <- @streams.insights} id={id} class="insight-row">
          <span>{insight_badge(insight)}</span><div>
            <strong>{insight.title}</strong><p>{insight.notes}</p>
          </div>
        </article>
      </div>
    </section>
  </div>
</Layouts.app>
