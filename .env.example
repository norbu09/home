# Copy to .env and fill in. docker compose reads .env automatically.

# ── Required ──────────────────────────────────────────────────────────────

# Password for the bundled Postgres container.
POSTGRES_PASSWORD=change-me

# Phoenix session/cookie signing. Generate: openssl rand -base64 48
SECRET_KEY_BASE=

# Encryption key for the secrets store (Crypto Keys page). Generate: openssl rand -base64 32
CLOAK_KEY=

# AshAuthentication token signing. Generate: openssl rand -base64 32
TOKEN_SIGNING_SECRET=

# ── Optional ──────────────────────────────────────────────────────────────

# Port the app listens on (host side too). Default 4070.
# PORT=4070

# Public hostname (used for absolute URLs). Default localhost.
# PHX_HOST=localhost

# Bearer token for the memory HTTP API used by the opencode plugin.
# If unset, create it in the Crypto Keys UI (service: memory, key: api_token).
# MEMORY_API_TOKEN=
